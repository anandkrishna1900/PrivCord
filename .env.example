# DuoChat environment template.
# Copy the relevant values into apps/desktop/.env and/or apps/android/local.properties.
# NEVER commit real secrets. Firebase web API keys are *identifiers*, not secrets;
# access is enforced by firestore.rules. Admin/service-account credentials must never
# be placed in either client.

# ---- Firebase web app (desktop) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Leave blank for production. Set to localhost when using the Firebase emulators.
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

# Fixed private conversation id. Must match config/access.conversationId in Firestore.
VITE_CONVERSATION_ID=duo

# Optional TURN relay (leave blank to disable). Short-lived credentials are preferred.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# STUN servers (comma separated). Defaults are used when blank.
VITE_STUN_URLS=

# ---- Firebase Android app ----
# Put these in apps/android/local.properties (not committed), or provide google-services.json.
# firebase.apiKey=...
# firebase.applicationId=...
# firebase.projectId=...
# firebase.messagingSenderId=...
# conversationId=duo
