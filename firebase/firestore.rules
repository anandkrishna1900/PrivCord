rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function accessDoc() {
      return get(/databases/$(database)/documents/config/access).data;
    }

    function memberIds() {
      return accessDoc().memberIds;
    }

    function isMember() {
      return signedIn() && request.auth.uid in accessDoc().memberIds;
    }

    function peerId() {
      return memberIds()[0] == request.auth.uid ? memberIds()[1] : memberIds()[0];
    }

    function configuredConversationId() {
      return accessDoc().conversationId;
    }

    function isConversation(cid) {
      return cid == configuredConversationId();
    }

    // Owner-managed allowlist. Only the original two members may read it.
    // No client can ever write it, even an approved member.
    match /config/access {
      allow get: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow list: if false;
      allow write: if false;
    }

    match /users/{uid} {
      function isSelf() {
        return uid == request.auth.uid;
      }

      function validProfileWrite() {
        let data = request.resource.data;
        return data.keys().hasOnly(['displayName', 'photoURL', 'createdAt', 'lastSeenAt'])
          && data.displayName is string
          && data.displayName.size() >= 1
          && data.displayName.size() <= 40
          && (!('photoURL' in data.keys()) || (data.photoURL is string && data.photoURL.size() <= 500))
          && data.createdAt is timestamp
          && data.lastSeenAt is timestamp;
      }

      allow read: if isMember() && (isSelf() || uid == peerId());
      allow create: if isMember() && isSelf() && validProfileWrite()
        && request.resource.data.createdAt == request.time;
      allow update: if isMember() && isSelf() && validProfileWrite()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /devices/{deviceId} {
        function validDeviceKey() {
          let key = request.resource.data.publicKeyJwk;
          return key is map
            && key.keys().hasOnly(['kty', 'crv', 'x', 'y'])
            && key.kty == 'EC'
            && key.crv == 'P-256'
            && key.x is string
            && key.x.size() >= 40
            && key.x.size() <= 120
            && key.y is string
            && key.y.size() >= 40
            && key.y.size() <= 120
            && !('d' in key.keys());
        }

        function validDeviceDoc() {
          let data = request.resource.data;
          return data.keys().hasOnly(['publicKeyJwk', 'createdAt', 'lastSeenAt'])
            && validDeviceKey()
            && (!('createdAt' in data.keys()) || data.createdAt is timestamp)
            && (!('lastSeenAt' in data.keys()) || data.lastSeenAt is timestamp);
        }

        allow read: if isMember() && (uid == request.auth.uid || uid == peerId());
        allow create, update: if isMember()
          && uid == request.auth.uid
          && validDeviceDoc();
        allow delete: if isMember() && uid == request.auth.uid;
      }
    }

    match /conversations/{cid} {
      function validMessageId(messageId) {
        return messageId is string && messageId.size() >= 1 && messageId.size() <= 64;
      }

      function validMessage() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'messageId', 'senderId', 'text', 'clientCreatedAt', 'createdAt',
            'type', 'clientMessageId', 'transport'
          ])
          && data.keys().hasAll([
            'messageId', 'senderId', 'text', 'clientCreatedAt', 'createdAt',
            'type', 'clientMessageId', 'transport'
          ])
          && validMessageId(data.messageId)
          && data.senderId == request.auth.uid
          && data.text is string
          && data.text.size() > 0
          && data.text.size() <= 16000
          && data.clientCreatedAt is number
          && data.clientCreatedAt > 0
          && data.createdAt == request.time
          && data.type == 'text'
          && validMessageId(data.clientMessageId)
          && data.transport in ['cloud', 'p2p'];
      }

      allow read: if isMember() && isConversation(cid);
      allow create, update, delete: if false;

      match /messages/{messageId} {
        function existing() {
          return get(/databases/$(database)/documents/conversations/$(cid)/messages/$(messageId)).data;
        }

        allow read: if isMember() && isConversation(cid);
        allow create: if isMember()
          && isConversation(cid)
          && request.resource.data.messageId == messageId
          && validMessage()
          && !exists(/databases/$(database)/documents/conversations/$(cid)/messages/$(messageId));
        // Idempotent retry of the sender's own immutable message. Only the
        // server timestamp may be refreshed; content cannot change.
        allow update: if isMember()
          && isConversation(cid)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.messageId == messageId
          && request.resource.data.clientMessageId == resource.data.clientMessageId
          && request.resource.data.clientCreatedAt == resource.data.clientCreatedAt
          && request.resource.data.text == resource.data.text
          && request.resource.data.type == resource.data.type
          && request.resource.data.transport == resource.data.transport
          && (request.resource.data.createdAt == request.time
            || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if false;
      }

      match /readStates/{uid} {
        allow read: if isMember() && isConversation(cid);
        allow write: if isMember()
          && isConversation(cid)
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['lastReadMessageId', 'lastReadAt'])
          && request.resource.data.lastReadMessageId is string
          && request.resource.data.lastReadMessageId.size() >= 1
          && request.resource.data.lastReadMessageId.size() <= 64
          && request.resource.data.lastReadAt == request.time;
        allow delete: if false;
      }

      match /signals/{signalId} {
        function validSignal() {
          let data = request.resource.data;
          return data.keys().hasOnly([
              'from', 'to', 'fromDeviceId', 'kind', 'sdp', 'createdAt', 'expiresAt'
            ])
            && data.keys().hasAll([
              'from', 'to', 'fromDeviceId', 'kind', 'sdp', 'createdAt', 'expiresAt'
            ])
            && data.from == request.auth.uid
            && data.to == peerId()
            && data.fromDeviceId is string
            && data.fromDeviceId.size() >= 1
            && data.fromDeviceId.size() <= 64
            && data.kind in ['offer', 'answer']
            && data.sdp is string
            && data.sdp.size() >= 20
            && data.sdp.size() <= 64000
            && data.createdAt == request.time
            && data.expiresAt is number;
        }

        allow read: if isMember()
          && isConversation(cid)
          && resource.data.to == request.auth.uid;
        allow create: if isMember()
          && isConversation(cid)
          && validSignal();
        allow delete: if isMember()
          && isConversation(cid)
          && resource.data.to == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
