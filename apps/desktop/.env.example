# Copy to .env. See the repository root .env.example for documentation.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Set to 127.0.0.1 to use the local Firebase emulators.
VITE_FIREBASE_EMULATOR_HOST=

VITE_CONVERSATION_ID=duo

# Optional TURN relay. Leave blank to disable (direct/STUN only).
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

VITE_STUN_URLS=
