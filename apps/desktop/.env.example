# Copy to .env. Everything is optional: DuoChat uses no accounts and no cloud backend.
VITE_CONVERSATION_ID=duo

# Optional TURN relay. Leave blank to disable (direct/STUN only).
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Comma-separated STUN servers used to discover your public address.
# Leave blank for the public defaults, or set to "none" to disable STUN (same-network only).
VITE_STUN_URLS=
